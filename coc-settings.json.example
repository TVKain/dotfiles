{
  "languageserver": {
    "c": {
      "command": "clangd",
      "filetypes": ["c", "cpp", "h", "hpp"],
      "rootPatterns": ["compile_commands.json", ".clangd", "Makefile", "build/"],
      "args": [
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "--fallback-style=llvm"
      ]
    }
  },
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--completion-style=detailed",
    "--function-arg-placeholders",
    "--fallback-style=llvm"
  ]
}
